# 复制为 .env 后填写；真实 .env 不提交、不打包。
# 两个服务可以来自不同提供商，BASE_URL 填兼容接口的基础地址（通常以 /v1 结尾）。
EDU_RAG_PROFILE=rag
EDU_EMBEDDING_BASE_URL=
EDU_EMBEDDING_API_KEY=
EDU_EMBEDDING_MODEL=
# 必须与 Embedding API 实际返回维度一致；1536 仅为配置示例，不会请求缩减维度。
EDU_EMBEDDING_DIMENSIONS=1536
# 提供商同名模型升级后可增加此版本以触发向量更新。
EDU_EMBEDDING_VERSION=1
# 仅当你的 Embedding 提供商要求查询前缀时填写。
EDU_EMBEDDING_QUERY_PREFIX=
EDU_LLM_PROVIDER=openai
EDU_LLM_BASE_URL=
EDU_LLM_API_KEY=
EDU_LLM_MODEL=
EDU_API_TIMEOUT=30
# 不同向量模型分数分布不同，需结合自己的资料校准。
EDU_SEMANTIC_MIN_SCORE=0.50
EDU_API_TOKEN=
